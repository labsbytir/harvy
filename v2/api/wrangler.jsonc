{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "harvy-api",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "harvy.dev/api/v1/*", "zone_name": "harvy.dev" },
    { "pattern": "harvy.dev/health", "zone_name": "harvy.dev" },
    { "pattern": "harvy.dev/internal/v1/automation-*", "zone_name": "harvy.dev" }
  ],
  "services": [
    { "binding": "AUTH", "service": "harvy-auth" }
  ],
  "r2_buckets": [
    { "binding": "HARVY_RAW", "bucket_name": "harvy-raw" },
    { "binding": "HARVY_ARTIFACTS", "bucket_name": "harvy-artifacts" }
  ],
  "d1_databases": [
    {
      "binding": "HARVY_D1",
      "database_name": "harvy-platform-v2",
      "database_id": "2fb9f8e4-ca31-4cd0-95b4-b084429816f2",
      "migrations_dir": "../migrations"
    }
  ]
}
