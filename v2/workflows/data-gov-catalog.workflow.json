{
  "name": "Harvy - data-gov-catalog Ingestion",
  "nodes": [
    {
      "parameters": {},
      "id": "wjlut8nGEQCg6DT8-001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "disabled": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build the job envelope for data-gov-catalog ingestion\n// Source ID for data.gov catalog datasets\nconst source_id = 'src_data-gov-catalog';\n\n// Deterministic idempotency key using execution ID\nconst idempotency_key = `n8n-${$execution.id}`;\n\n// Return the job envelope\nreturn [{ \n  json: { \n    source_id: source_id, \n    idempotency_key: idempotency_key,\n    product: 'ops',\n    tenant_id: 'shared',\n    workspace_id: 'shared',\n    captured_at: new Date().toISOString()\n  } \n}];"
      },
      "id": "wjlut8nGEQCg6DT8-002",
      "name": "Build Job Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://harvy.dev/api/v1/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-harvy-organization-id",
              "value": "REPLACE_WITH_ORGANIZATION_ID"
            },
            {
              "name": "x-harvy-product",
              "value": "ops"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "wjlut8nGEQCg6DT8-003",
      "name": "Submit to Harvy Automation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "continueOnFail": false
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[
        {
          "node": "Build Job Envelope",
          "type": "main",
          "index": 0
        }
      ]]
    },
    "Build Job Envelope": {
      "main": [[
        {
          "node": "Submit to Harvy Automation",
          "type": "main",
          "index": 0
        }
      ]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "workflowId": "Wjlut8nGEQCg6DT8",
