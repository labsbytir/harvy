{
  "name": "Harvy - Kaggle Dataset Ingestion",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 2,
              "minute": 0
            }
          ]
        }
      },
      "id": "kaggle-cron-trigger",
      "name": "Daily Cron Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "disabled": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build job envelope for Kaggle dataset ingestion\nconst source_id = 'src_kaggle';\nconst idempotency_key = `kaggle-ingestion-${$execution.id}`;\nconst event_id = `src_kaggle_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n\n// Configuration from environment\nconst config = {\n  kaggleApiToken: $vars.KAGGLE_API_TOKEN,\n  databaseUrl: $vars.DATABASE_URL,\n  cloudflareAccountId: $vars.CLOUDFLARE_ACCOUNT_ID,\n  r2AccessKeyId: $vars.R2_ACCESS_KEY_ID,\n  r2SecretAccessKey: $vars.R2_SECRET_ACCESS_KEY,\n  r2BucketName: $vars.R2_BUCKET_NAME || 'harvy-artifacts',\n  searchQuery: $vars.KAGGLE_SEARCH_QUERY || 'united states',\n  maxDatasets: parseInt($vars.KAGGLE_MAX_DATASETS || '5')\n};\n\nreturn [{\n  json: {\n    source_id: source_id,\n    idempotency_key: idempotency_key,\n    event_id: event_id,\n    product: 'automation',\n    tenant_id: 'shared',\n    workspace_id: 'shared',\n    captured_at: new Date().toISOString(),\n    config: config,\n    provenance: {\n      source: 'kaggle',\n      method: 'api-ingestion',\n      scope: 'dataset-discovery',\n      watermark: {\n        cursor: '',\n        forward: new Date().toISOString()\n      },\n      workflow_id: 'kaggle-ingestion-workflow',\n      execution_id: $execution.id,\n      spider_request_id: `kaggle-${Date.now()}-${Math.random().toString(36).substr(2, 6)}`\n    }\n  }\n}];"
      },
      "id": "build-kaggle-job",
      "name": "Build Kaggle Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://harvy.dev/api/v1/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-harvy-organization-id",
              "value": "REPLACE_WITH_ORGANIZATION_ID"
            },
            {
              "name": "x-harvy-product",
              "value": "automation"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "submit-kaggle-job",
      "name": "Submit to Harvy Automation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        200
      ],
      "continueOnFail": false
    },
    {
      "parameters": {
        "eventName": "workflowError"
      },
      "id": "kaggle-error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        460,
        500
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Log Kaggle workflow errors\nconst errorMsg = $json.error?.message || JSON.stringify($json.error) || 'Unknown error';\nconst workflowName = 'Harvy - Kaggle Dataset Ingestion';\nconst executionId = $execution.id;\nconst occurredAt = new Date().toISOString();\n\nreturn [{\n  json: {\n    workflow_id: 'kaggle-ingestion-workflow',\n    workflow_name: workflowName,\n    execution_id: executionId,\n    error_message: errorMsg.substring(0, 500),\n    occurred_at: occurredAt,\n    source_id: 'src_kaggle',\n    severity: 'error',\n    trace_id: $vars.OPENOBSERVE_TRACE_ID || `trace-${Date.now()}`\n  }\n}];"
      },
      "id": "log-kaggle-error",
      "name": "Log Error to connector_errors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://harvy.dev/internal/v1/automation-callback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-harvy-timestamp",
              "value": "={{ new Date().toISOString() }}"
            },
            {
              "name": "x-harvy-signature",
              "value": "={{ $vars.AUTOMATION_CALLBACK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "kaggle-error-callback",
      "name": "Post Error Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        500
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Manual trigger for on-demand Kaggle ingestion\nconst datasetIdentifier = $json.dataset_id || $vars.KAGGLE_DATASET_ID;\n\nif (!datasetIdentifier) {\n  return [{\n    json: {\n      error: 'No dataset_id provided. Set KAGGLE_DATASET_ID variable or provide in trigger.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    dataset_id: datasetIdentifier,\n    action: 'import',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "manual-kaggle-trigger",
      "name": "Manual Dataset Trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        400
      ]
    }
  ],
  "connections": {
    "Daily Cron Trigger": {
      "main": [
        [
          {
            "node": "Build Kaggle Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Kaggle Job": {
      "main": [
        [
          {
            "node": "Submit to Harvy Automation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Dataset Trigger": {
      "main": [
        [
          {
            "node": "Build Kaggle Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Log Error to connector_errors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error to connector_errors": {
      "main": [
        [
          {
            "node": "Post Error Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveExecutionProgress": true,
    "errorWorkflow": {
      "active": true,
      "errorWorkflowId": "kaggle-ingestion-workflow"
    }
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "workflowId": "kaggle-ingestion-workflow",
    "source": "kaggle",
    "description": "Continuous ingestion workflow for Kaggle datasets. Supports scheduled discovery and manual imports.",
    "mcp_endpoint": "https://n8n.harvy.dev/mcp-server/http",
    "mcp_auth": "Bearer {{ $vars.N8N_MCP_KEY }}",
    "mcp_operations": {
      "create": "workflows.create_workflow",
      "update": "workflows.update_workflow",
      "validate": "workflows.validate_workflow",
      "execute": "workflows.execute_workflow",
      "activate": "workflows.activate_workflow",
      "deactivate": "workflows.deactivate_workflow",
      "publish": "workflows.publish_workflow"
    },
    "required_mcp_tools": [
      "workflows.create_workflow",
      "workflows.update_workflow",
      "workflows.validate_workflow",
      "workflows.execute_workflow",
      "workflows.search_workflows",
      "workflows.get_workflow",
      "workflows.activate_workflow",
      "workflows.deactivate_workflow"
    ],
    "requirements": [
      "KAGGLE_API_TOKEN must be set in n8n variables",
      "DATABASE_URL must be configured for PostgreSQL connection",
      "CLOUDFLARE_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY must be set for R2 access",
      "BASIN_SEND_TOKEN must be configured for analytics",
      "connector_errors data table must exist",
      "WEBSHARE_PROXY_URL must be set (for fallback if needed)"
    ],
    "provenance": {
      "created": "2026-10-30",
      "created_by": "workflow-builder",
      "pattern": "api-ingestion-generic"
    },
    "gates_before_activation": [
      "kaggle_api_token_configured",
      "database_connection_configured",
      "r2_credentials_configured",
      "secrets_from_n8n_variables_only_no_hardcoded",
      "provenance_tracking_with_event_id_and_workflow_id",
      "deterministic_event_id_format_src_dataset_executionid",
      "dedupe_data_table_exists_connector_errors",
      "openobserve_tracing_configured_service_n8n"
    ],
    "openobserve_config": {
      "service": "n8n",
      "traces_endpoint": "eu1-api.openobserve.ai/api/3LOzR02TywfzyWfDySBb0aS1DrE/v1/traces",
      "logs_endpoint": "eu1-api.openobserve.ai/api/3LOzR02TywfzyWfDySBb0aS1DrE/v1/logs",
      "correlation_key": "execution_id",
      "trace_attributes": [
        "workflowId",
        "source_id",
        "event_id",
        "dataset_id"
      ]
    }
  }
}