# Kaggle API Configuration
KAGGLE_API_TOKEN=KGAT_your_api_token_here

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/harvy
# OR individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=harvy
DB_USER=username
DB_PASSWORD=password

# Cloudflare R2 Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=harvy-artifacts

# Pipeline Configuration
MAX_CONCURRENT_DOWNLOADS=3
RATE_LIMIT_DELAY=1000

# Optional: UpCloud Database (as mentioned by user)
# UP_CLOUD_DB_HOST=85.9.196.97
# UP_CLOUD_DB_PORT=5432
# UP_CLOUD_DB_NAME=harvy
# UP_CLOUD_DB_USER=username
# UP_CLOUD_DB_PASSWORD=password