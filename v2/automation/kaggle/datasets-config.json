  "import_strategies": {
    "full_import": {
      "description": "Import all data from selected datasets",
      "recommended_for": ["small datasets", "critical data", "one-time imports"],
      "settings": {
        "importFiles": true,
        "storeInR2": true,
        "storeInDatabase": true,
        "processFiles": true
      }
    },
    "metadata_only": {
      "description": "Import only metadata, not actual files",
      "recommended_for": ["large datasets", "initial discovery", "catalog building"],
      "settings": {
        "importFiles": false,
        "storeInR2": false,
        "storeInDatabase": true,
        "processFiles": false
      }
    },
    "sample_import": {
      "description": "Import sample data for evaluation",
      "recommended_for": ["dataset evaluation", "testing", "proof of concept"],
      "settings": {
        "importFiles": true,
        "storeInR2": true,
        "storeInDatabase": true,
        "processFiles": true,
        "maxFiles": 3,
        "sampleRows": 1000
      }
    },
    "scheduled_sync": {
      "description": "Regularly sync with Kaggle for updates",
      "recommended_for": ["frequently updated datasets", "ongoing monitoring"],
      "settings": {
        "importFiles": true,
        "storeInR2": true,
        "storeInDatabase": true,
        "processFiles": true,
        "schedule": "daily",
        "checkForUpdates": true
      }
    }
  }
