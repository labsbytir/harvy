{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "v2/web/**/*.ts",
    "v2/web/**/*.tsx",
    "v2/shared/**/*.ts",
    "v2/tests/**/*.mts"
  ],
  "exclude": [
    "v2/api",
    "v2/auth",
    "node_modules"
  ]
}
