{
  "name": "harvy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config v2/web/vite.config.ts",
    "build": "vite build --config v2/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test v2/tests/*.test.mjs",
    "test:automation": "python3 -m unittest discover -s v2/automation -p 'test_*.py'",
    "check:local": "npm run typecheck && npm test && npm run test:automation && npm run build",
    "typecheck:auth": "tsc -p v2/auth/tsconfig.json",
    "typecheck:auth-client": "tsc -p v2/auth/tsconfig.client.json",
    "test:auth-consent": "node --test v2/auth/privacy-consent.test.mjs",
    "build:auth-client": "vite build --config v2/auth/vite.config.mts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^6.5.0",
    "drizzle-cube": "0.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.3.0",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "better-auth": "^1.7.13",
    "better-auth-cloudflare": "^0.4.1",
    "@better-auth/api-key": "^1.7.13",
    "@better-auth/passkey": "^1.7.13",
    "@better-auth/stripe": "^1.7.13",
    "@better-auth/infra": "^0.4.22",
    "@marinedotsh/better-auth-referral": "^0.3.0",
    "drizzle-orm": "^0.45.4",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "@cloudflare/workers-types": "^5.20261025.1",
    "drizzle-kit": "^0.31.11",
    "@types/node": "24.10.1"
  }
}
